/*
 * Sofle Choc — matrice 60, firmware actif = port Corne 42 Vial (42 switches peuplés).
 * Indices : 0–11 rangée1, 12–23 rangée2, 24–35 rangée3, 36–49 rangée4, 50–59 pouces
 *           RC(4,0)…(4,4) puis RC(4,7)…(4,11).
 *
 * Positions actives Corne : 12–41, 44–49, 52–57. Hors Corne : &none dans le layout.
 * Layout Townk (60 touches) : config/layout/standard_layout.dtsi (non inclus).
 */

/* Hold-tap positionnels : 42 touches Corne uniquement (hors chiffres / HYP / pouces externes) */
#define KEYS_L 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41
#define KEYS_R 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49
#define THUMBS 52 53 54 55 56 57

#define LT5 0
#define LM5 24
#define LB5 36
#define LB3 39
#define LB2 40
#define LB1 41
#define RB1 44
#define RB2 45
#define RB3 46

/* Combo Caps Word Townk désactivé ; combo J+K+L→Enter dans corne_vial_layout.dtsi */
/* #define COMBO_KEY_CAPS_WORD <28 31> */

