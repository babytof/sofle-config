#define ZMK_POINTING_DEFAULT_SCRL_VAL 35
#define ZMK_MOUSE_DEFAULT_MOVE_VAL ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_MOUSE_DEFAULT_SCRL_VAL ZMK_POINTING_DEFAULT_SCRL_VAL

/*
 * SOFLE60 : entrée « grille Townk 14×4 + 12 pouces », sortie 60 touches Sofle.
 * Retire K18–K19 et K32–K33 des rangées 2–3 ; rangée4 insère K18–K19 entre les
 * deux moitiés (HYP) ; pouces sans K60 ni K63 (non câblés).
 */
#define SOFLE60( \
    K00, K01, K02, K03, K04, K05,                         K06, K07, K08, K09, K10, K11, \
    K12, K13, K14, K15, K16, K17, K18, K19, K20, K21, K22, K23, K24, K25, \
    K26, K27, K28, K29, K30, K31, K32, K33, K34, K35, K36, K37, K38, K39, \
    K40, K41, K42, K43, K44, K45, K46, K47, K48, K49, K50, K51, K52, K53, \
              K54, K55, K56, K57, K58, K59, K60, K61, K62, K63, K64, K65 \
) \
    K00 K01 K02 K03 K04 K05                         K06 K07 K08 K09 K10 K11 \
    K12 K13 K14 K15 K16 K17                         K20 K21 K22 K23 K24 K25 \
    K26 K27 K28 K29 K30 K31                         K34 K35 K36 K37 K38 K39 \
    K40 K41 K42 K43 K44 K45 K18 K19 K48 K49 K50 K51 K52 K53 \
              K54 K55 K56 K57 K58 K59 K61 K62 K64 K65

